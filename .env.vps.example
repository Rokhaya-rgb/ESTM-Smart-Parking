# Configuration du VPS (relais MQTT). Copier en .env — ne jamais committer .env.
APP_NAME="Parking ESTM"
APP_ENV=production
# Générer avec : php artisan key:generate --show
APP_KEY=

MQTT_USERNAME=parking_estm
MQTT_PASSWORD=

# URL du site sur le mutualisé + clé partagée (identique à INGEST_API_KEY du site)
MQTT_FORWARD_URL=https://VOTRE-DOMAINE/api/mqtt
# Générer avec : php -r "echo bin2hex(random_bytes(32));"
INGEST_API_KEY=
